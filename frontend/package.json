{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "dev:mobile": "vite --config vite.config.mobile.js",
    "build:mobile": "vite build --config vite.config.mobile.js && cp dist-mobile/index.mobile.html dist-mobile/index.html",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:mobile": "vite preview --config vite.config.mobile.js --outDir dist-mobile",
    "deploy:pc": "npx wrangler pages deploy dist --project-name=s-guard-ai && npx wrangler pages deploy dist --project-name=sguard-frontend",
    "deploy:mobile": "npx wrangler pages deploy dist-mobile --project-name=sguard-mobile",
    "deploy:all": "npm run build && npm run build:mobile && npm run deploy:pc && npm run deploy:mobile"
  },
  "dependencies": {
    "@react-oauth/google": "^0.13.4",
    "dompurify": "^3.4.5",
    "echarts": "^5.5.0",
    "echarts-for-react": "^3.0.2",
    "framer-motion": "^12.29.0",
    "html2pdf.js": "^0.14.0",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.563.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hot-toast": "^2.6.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.0",
    "recharts": "^3.7.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "vite": "^7.2.4"
  }
}
